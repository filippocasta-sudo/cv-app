# Password del pannello admin (/admin). Obbligatoria per accedere al CMS.
ADMIN_PASSWORD=cambiami

# Opzionale: separa la firma delle sessioni dalla password.
# Ruotando ADMIN_PASSWORD le sessioni attive vengono invalidate in ogni caso.
# ADMIN_SESSION_SECRET=una-stringa-lunga-e-casuale

# Storage dei contenuti.
#
# In locale i contenuti vengono salvati su file: data/cv-content.json.
# Su Vercel il filesystem è in sola lettura, quindi il salvataggio richiede un
# Blob store collegato al progetto. Vercel inietta BLOB_READ_WRITE_TOKEN
# automaticamente e l'applicazione passa da sola al driver Blob.
#
# Per usare il driver Blob anche in locale, copia il token dal dashboard Vercel:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Opzionale: cambia il percorso del file JSON usato dal driver su filesystem.
# CV_DATA_FILE=/percorso/assoluto/cv-content.json

# Opzionale: origine pubblica usata per canonical, Open Graph, robots e sitemap.
# Su Vercel viene ricavata da VERCEL_PROJECT_PRODUCTION_URL, quindi serve solo
# per sovrascriverla (per esempio con un dominio proprio).
# NEXT_PUBLIC_SITE_URL=https://filippocastagna-cv.vercel.app
